    "unit_bearing": { "gate": "hard", "metric": "recall@limit + hit@1 + exclusions", "threshold": 1.0 },
    "supported_synonyms": { "gate": "hard", "metric": "hit@1 / recall@limit", "threshold": 1.0, "supported": ["case", "accents", "unit spellings: 20 kg / 20kg / 20kgs / 20 kilos", "singular/plural (trailing s)"] },
